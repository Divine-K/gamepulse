# Copy to .env.production (never commit it) and replace every value.
# Used with: docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-random-hex-characters

POSTGRES_USER=gamepulse
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gamepulse

# Public port of the dashboard (nginx). Put a TLS terminator in front of it.
WEB_PORT=8080

# Optional tuning
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# AUTH_RATE_LIMIT_PER_MINUTE=10
# GAME_API_RATE_LIMIT_PER_MINUTE=600
# WEB_CONCURRENCY=2
# LOG_LEVEL=INFO
